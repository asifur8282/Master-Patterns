{
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*).json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/json\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!\\.well-known|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
